# ==========================================
# JARVIS Core Configuration
# ==========================================

# AI provider
AI_PROVIDER=openai       # options: openai | groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq Cloud API Key (optional fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Voice Pipeline (STT & TTS)
STT_ENGINE=groq_whisper       # options: groq_whisper | browser
TTS_PROVIDER=elevenlabs       # options: edge | google | elevenlabs (default: elevenlabs)
TTS_API_KEY=                  # required for google; leave empty for Edge/elevenlabs
ELEVENLABS_API_KEY=           # REQUIRED when TTS_PROVIDER=elevenlabs - get from https://elevenlabs.io
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB   # Default multilingual voice (supports English + Urdu)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_VOICE_ID=en-GB-RyanNeural
TTS_VOICE_UR=ur-PK-AsadNeural
TTS_VOICE_EN=en-GB-RyanNeural
TTS_RATE=-2%
TTS_RATE_UR=-8%
TTS_PITCH=+0Hz
WAKE_WORD_ENABLED=false        # set to true for background microphone wake-word listening
WAKE_WORD=jarvis

# Gmail SMTP Tool (Requires 16-character Google App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Database File
DATABASE_PATH=jarvis.db
